# Configuracion de UNA instancia. Copiar a .env dentro de la carpeta del cliente.
# NUNCA subir el .env real a Git. chmod 600 .env

# --- Identidad de la instancia (usado por compose y Traefik) ---
# TENANT: identificador unico, sin espacios ni mayusculas (ej: cliente1, panaderia-sur).
TENANT=cliente1
# DOMAIN: dominio exacto que sirve esta instancia (debe apuntar al servidor por DNS).
DOMAIN=cliente1.tudominio.cl

# --- Version de imagen a desplegar ---
# latest = ultima publicada. Puedes fijar un SHA para rollback.
IMAGE_TAG=latest

# --- LibreDTE (solo accesible desde la red privada del tenant) ---
# La imagen queda fijada por digest; cambiarla es una actualización explícita.
LIBREDTE_IMAGE=ghcr.io/libredte/libredte-lib-core-api@sha256:a953e36b3a3fa1f6b570834d19511dd0a674e2ede66f0b7b8a0004579ad21587
LIBREDTE_TIMEOUT_SECONDS=60

# --- Base de datos (propia de este cliente) ---
# ASP.NET convierte __ en : al leer variables de entorno.
ConnectionStrings__SgalConnection='Server=HOST_SQL,1433;Database=SGAL_CLIENTE1;User Id=USUARIO;Password=CAMBIAR;Encrypt=True;TrustServerCertificate=False;'

# --- Integraciones privadas del cliente ---
MercadoPagoPoint__AccessToken=
MercadoPagoPoint__TerminalId=
MercadoPagoPoint__WebhookSecret=
MercadoPagoPoint__AllowSimulation=false
